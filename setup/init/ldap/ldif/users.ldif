# Create organizational units
dn: ou=users,dc=lab,dc=local
objectClass: organizationalUnit
ou: users

dn: ou=groups,dc=lab,dc=local
objectClass: organizationalUnit
ou: groups

# Users
dn: uid=developer1,ou=users,dc=lab,dc=local
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
uid: developer1
cn: Developer One
sn: One
givenName: Developer
displayName: Developer One
mail: developer1@lab.local
userPassword: developer1
uidNumber: 10001
gidNumber: 10001
homeDirectory: /home/developer1
loginShell: /bin/bash

